{
  "name": "ntu-cricket-scorer",
  "private": true,
  "version": "1.0.0",
  "description": "Local ball-by-ball scoring, player profiles and stats for NTU Cricket Club",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:offline": "vite --host --mode offline",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^13.0.0",
    "html-to-image": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
